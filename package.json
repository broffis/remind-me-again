{
  "name": "remind-me-again",
  "version": "0.6.0",
  "description": "Install a Copilot skill for local session summaries, rollups, and opt-in context retrieval.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broffis/remind-me-again.git"
  },
  "bin": {
    "remind-me-again": "bin/remind-me-again.cjs"
  },
  "files": [
    "bin/remind-me-again.cjs",
    "install.py",
    "remind-me-again/SKILL.md",
    "remind-me-again/scripts/*.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:coverage": "c8 --all --include='bin/**/*.cjs' --include='.github/scripts/**/*.cjs' --check-coverage --lines=90.01 npm test"
  },
  "devDependencies": {
    "c8": "10.1.3"
  }
}
